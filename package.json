{
  "name": "dsh-real-ip",
  "version": "0.1.0",
  "displayName": "Real IP",
  "description": "When fake-ip DNS answers a DSH lookup, pin the real public address instead. Literal and private addresses stay blocked.",
  "license": "MIT",
  "author": "NingYuanLee",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./allow": "./src/allow.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "SECURITY.md",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/allow.js && node --check src/classify.js && node --check src/real.js && node --check src/dns-patch.js",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check && npm run check:pack"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingYuanLee/dsh-real-ip.git"
  },
  "homepage": "https://github.com/NingYuanLee/dsh-real-ip#readme",
  "bugs": {
    "url": "https://github.com/NingYuanLee/dsh-real-ip/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "web-fetch",
    "fake-ip",
    "clash",
    "sing-box"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
